# ============================================================================
# AUI CAMPUS MANHUNT — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development, and add these 5 variables
# in Vercel under Project Settings -> Environment Variables.
# ============================================================================

# 1. Public URL of your app (use http://localhost:3000 locally, or your https://...vercel.app link in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 3. Supabase Public Anon Key (Safe for browser; enforces Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 4. Supabase Service Role Secret Key (SERVER-ONLY! Never prefix with NEXT_PUBLIC_ or expose to browsers)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 5. Private Storage Bucket Name for 1-Time Hider Photo Requests
SUPABASE_PHOTO_BUCKET=manhunt-private-photos
